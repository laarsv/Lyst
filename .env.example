# =============================================================================
#  Lyst — environment configuration
# =============================================================================
#  Copy this file to `.env` and fill in the values you need.
#  Required variables are marked [required]; everything else has a sane default
#  or simply disables an optional feature when left blank.
#
#  Quick start: set SECRET_KEY (long random string) and the INITIAL_ADMIN_*
#  values, then `docker compose up -d`. Email and AI can be added later.
# =============================================================================


# -----------------------------------------------------------------------------
#  Database — PostgreSQL
# -----------------------------------------------------------------------------
# Credentials for the bundled `db` service. The backend reads them via
# DATABASE_URL below; if you point at an external Postgres, only DATABASE_URL
# matters.
POSTGRES_USER=lyst
POSTGRES_PASSWORD=change-me-postgres-password   # [required] use a strong value in production
POSTGRES_DB=lyst

# Async SQLAlchemy connection string. Inside docker-compose the host is `db`.
# For an external database, change to:
#   postgresql+asyncpg://USER:PASSWORD@your-db-host:5432/lyst
DATABASE_URL=postgresql+asyncpg://lyst:change-me-postgres-password@db:5432/lyst


# -----------------------------------------------------------------------------
#  Auth — JWT + initial admin user
# -----------------------------------------------------------------------------
# [required] Signs every JWT. MUST be a long random string in production.
# Generate one with:  openssl rand -hex 32
SECRET_KEY=replace-with-a-long-random-string

# Token lifetimes. Defaults are fine for most setups.
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Initial admin user — created the very first time the backend starts against
# an empty database. After that the values are ignored, so you can change the
# admin's password from inside the app and these stay as a bootstrap record.
# Note: pydantic's EmailStr rejects `.local` (and other non-public TLDs), so
# the placeholder is `example.com` even for purely local installs.
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=ChangeMe123!              # [required] change before going public
INITIAL_ADMIN_NAME=Admin


# -----------------------------------------------------------------------------
#  Storage — user-uploaded files (optional)
# -----------------------------------------------------------------------------
# Where the backend writes user uploads (recipe hero images, …). The host
# path is bind-mounted into /app/uploads inside the backend container, and
# files are served via /static/. Default keeps everything local; production
# self-hosters typically point this at /opt/appdata/lyst/uploads.
UPLOADS_DIR=./uploads


# -----------------------------------------------------------------------------
#  App URLs and CORS
# -----------------------------------------------------------------------------
# Public URL the browser uses to reach the frontend. Used in invitation
# emails, password-reset links, and the public share QR code, so it must
# match what users actually see in their address bar.
FRONTEND_URL=http://localhost:8091

# Comma-separated list of origins allowed to call the API. Include every
# host the app will be served from (dev + prod), without trailing slash.
BACKEND_CORS_ORIGINS=http://localhost:8091,http://localhost:5173


# -----------------------------------------------------------------------------
#  Email — Resend (optional)
# -----------------------------------------------------------------------------
# Lyst uses Resend to send invitations, password resets, and reminders.
# Leave RESEND_API_KEY empty to disable outbound mail — the app still works,
# but invitations and reset flows print the link to the backend log instead
# of sending a real message. See docs/EMAIL.md for setup.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Lyst <noreply@your-domain.app>


# -----------------------------------------------------------------------------
#  AI — Ollama (optional, recommended)
# -----------------------------------------------------------------------------
# Lyst can use a local Ollama server for shopping-item categorization, recipe
# URL/photo import, and "what can I cook?" suggestions. With no Ollama
# reachable, those AI features just return a polite error — nothing else
# breaks. See docs/OLLAMA.md for model recommendations and setup.
#
# Pick whichever URL reaches your Ollama from inside the backend container:
#   - http://host.docker.internal:11434  (Ollama on the same host; works
#     thanks to the `extra_hosts` mapping in docker-compose.yml)
#   - http://<host-LAN-ip>:11434          (Ollama on another machine)
#   - http://ollama:11434                 (Ollama as a sibling compose service)
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Text-generation model — used for categorization, URL recipe import,
# suggestions. Must be pulled on the Ollama host first:
#   ollama pull llama3.1:8b
OLLAMA_TEXT_MODEL=llama3.1:8b

# Vision-capable model used by the photo recipe importer. Leave empty to
# disable photo import while keeping text features working.
#   ollama pull llava:7b
OLLAMA_VISION_MODEL=llava:7b

# How long Ollama keeps a model resident in (V)RAM after a request:
#   "-1" = forever, "1h" / "30m" / "5s" = duration, "0" = unload immediately.
# Text is hot-path (every shopping item is categorized) — pin forever so the
# next call is instant. Vision is rare → 1h frees memory if unused.
OLLAMA_TEXT_KEEP_ALIVE=-1
OLLAMA_VISION_KEEP_ALIVE=1h


# -----------------------------------------------------------------------------
#  AI — Anthropic Claude (optional, alternative to Ollama)
# -----------------------------------------------------------------------------
# Cloud LLM provider as an alternative for recipe import / suggestions.
# Pay-per-token; get a key at https://console.anthropic.com/settings/keys
# Leave empty to keep Claude disabled — the admin can still pick the
# provider in the UI but the call returns a clear error.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5


# -----------------------------------------------------------------------------
#  Nutrition lookup — Open Food Facts
# -----------------------------------------------------------------------------
# When a user adds or imports a recipe ingredient, the backend looks it up
# in Open Food Facts (https://world.openfoodfacts.org) to auto-fill the
# per-100g nutrition fields. OFF is free, anonymous, no API key needed;
# Lyst caches each query for 7 days in-process and rate-limits outgoing
# calls to ~1/sec, identifying itself via a Lyst/1.3 User-Agent per OFF's
# fair-use guidance.
#
# Set NUTRITION_LOOKUP_ENABLED=false if you want to keep all recipe data
# local — the Nährwerte sheet then only offers the Ollama estimate + the
# manual-entry path. Already-saved nutrition values are unaffected; this
# only governs new lookups.
NUTRITION_LOOKUP_ENABLED=true
