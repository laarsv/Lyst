# --- PostgreSQL ---
POSTGRES_USER=lyst
POSTGRES_PASSWORD=lyst
POSTGRES_DB=lyst

# --- Backend ---
DATABASE_URL=postgresql+asyncpg://lyst:lyst@db:5432/lyst
SECRET_KEY=replace-with-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Resend (transactional email) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=Lyst <noreply@your-domain.app>

# --- URLs ---
FRONTEND_URL=http://localhost:5173
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Initial admin user (created on first run only) ---
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=ChangeMe123!
INITIAL_ADMIN_NAME=Admin

# --- Ollama (local LLM provider) ---
# Pick whichever reaches your Ollama from inside the backend container:
#   - http://host.docker.internal:11434  (works thanks to extra_hosts in compose)
#   - http://<host-LAN-ip>:11434          (if Ollama runs on a different machine)
OLLAMA_BASE_URL=http://host.docker.internal:11434
# Text-generation model — categorization, recipe URL import, suggestions.
# (Legacy var name OLLAMA_MODEL is still accepted as a fallback.)
OLLAMA_TEXT_MODEL=llama3.1:8b
# Vision-capable model used by the photo importer (llava, llama3.2-vision,
# qwen2.5-vl, …). Empty string disables the photo-import feature.
OLLAMA_VISION_MODEL=llava:7b
# How long Ollama keeps a model resident in (V)RAM after a request:
#   "-1" = forever, "1h"/"30m"/"5s" = duration, "0" = unload immediately.
# Text is hot-path (every shopping item gets categorized) — pin forever so
# you never pay a 30–180s reload. Vision is rare → 1h frees RAM if unused.
OLLAMA_TEXT_KEEP_ALIVE=-1
OLLAMA_VISION_KEEP_ALIVE=1h

# --- Anthropic Claude (cloud LLM provider, alternative to Ollama) ---
# Get a key at https://console.anthropic.com/settings/keys (pay-per-token).
# Leave empty to disable Claude entirely; admin can still pick the provider
# but the call will return a clear error.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
