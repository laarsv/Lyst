# --- PostgreSQL ---
POSTGRES_USER=lyst
POSTGRES_PASSWORD=lyst
POSTGRES_DB=lyst

# --- Backend ---
DATABASE_URL=postgresql+asyncpg://lyst:lyst@db:5432/lyst
SECRET_KEY=replace-with-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Resend (transactional email) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=Lyst <noreply@your-domain.app>

# --- URLs ---
FRONTEND_URL=http://localhost:5173
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Initial admin user (created on first run only) ---
INITIAL_ADMIN_EMAIL=admin@lyst.local
INITIAL_ADMIN_PASSWORD=ChangeMe123!
INITIAL_ADMIN_NAME=Admin

# --- Ollama (local LLM, used for the recipe URL importer) ---
# From inside Docker, point this at your host LAN IP, e.g. http://192.168.178.6:11434
OLLAMA_BASE_URL=http://192.168.178.6:11434
OLLAMA_MODEL=llama3
